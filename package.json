{
  "name": "trello-orchestrator",
  "version": "0.1.0",
  "description": "Trello webhook control plane for validated, ID-based Agentic SDLC transitions and stage handoffs.",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "bootstrap-board": "tsx src/boardBootstrapCli.ts",
    "spec-design:manual": "tsx src/manualSpecDesignCli.ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
